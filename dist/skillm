    "_install_agent_option = click.option('--target', '-t', 'agent', default=None, type=click.Choice(adapter_names()), help='Install target (default: claude, codex, cursor)')",
    "_agent_option = click.option('--target', '-t', 'agent', default=DEFAULT_TARGET, type=click.Choice(adapter_names()), help='Install target (default: agents)')",
    "_root_option = click.option('--project-root', '-r', default=None, type=click.Path(exists=True), help='Project root directory (default: cwd)')",
    '',
    "@cli.command('install')",
    "@click.argument('name', required=False, default=None)",
    "@click.option('--pin', is_flag=True, help='Pin to current commit (skip on upgrade)')",
    "@click.option('--hard', is_flag=True, help='Copy files instead of symlinking (frozen snapshot)')",
    "@click.option('-g', '--global', 'global_install', is_flag=True, help='Install into global agent config (~/.claude/skills/)')",
    "@click.option('--tag', 'install_tag', default=None, help='Install all skills matching a tag')",
    "@click.option('-c', '--category', 'install_category', default=None, help='Install all skills matching a category')",
    "@click.option('--repo', default=None, help='Install from a specific repo (default: all repos)')",
    '@_install_agent_option',
    '@_root_option',
    'def install_cmd(name, pin, hard, global_install, install_tag, install_category, repo, agent, project_root):',
    '    """Install skills from the library into this project (or globally).',
    '',
    '    Default is soft install (symlink to library, always latest).',
    '',
    '    \\x08',
    '    skillm install deploy-k8s              Symlink to library (default, soft)',
    '    skillm install deploy-k8s --hard       Copy files into project (frozen)',
    '    skillm install deploy-k8s -g           Install globally (~/.claude/skills/)',
    "    skillm install --tag k8s               Symlink all skills tagged 'k8s'",
    '    skillm install --tag k8s --repo team   Install from specific repo',
    '    skillm install -c infra                Install all skills in category',
    '    """',
    '    from .check import check_requirements',
    '    from .metadata import extract_metadata',
    '    if global_install and project_root:',
    "        raise click.UsageError('--global and --project-root cannot be used together')",
    '    if global_install:',
    '        project_root = str(Path.home())',
    "    install_targets = (agent,) if agent else ('claude', 'codex', 'cursor')",
    '    agent = install_targets[0]',
    '    project = _get_project(agent=agent, project_root=project_root)',
    '    lib = project.library',
    '    soft = not hard',
    "    mode = 'hard' if hard else 'soft'",
    '',
    '    def _warn_conflicts(skill_name):',
    '        conflicts = project.find_skill_conflicts(skill_name)',
    '        for p in conflicts:',
    '            console.print(f"[yellow]Warning: \'{skill_name}\' already exists at {p} — agent may load duplicates[/yellow]")',
    '',
    '    def _install_one(skill_name, source_repo=None):',
    '        _warn_conflicts(Path(skill_name).name)',
    "        install_name = f'{source_repo}:{skill_name}' if source_repo else skill_name",
    '        result = project.add(install_name, pin=pin, soft=soft)',
    "        label = 'linked' if result == 'linked' else 'copied'",
    '        for mirror_agent in install_targets[1:]:',
    '            mirror = _get_project(agent=mirror_agent, project_root=project_root)',
    '            mirror.add(install_name, pin=pin, soft=soft)',
    "        target_label = ', '.join(install_targets)",
    "        console.print(f'[green]Installed {skill_name} → {label} ({target_label})[/green]')",
    '    if install_tag:',
    '        matches = lib.find_skills_by_tag(install_tag, repo=repo)',
    '        if not matches:',
    '            console.print(f"[dim]No skills found with tag \'{install_tag}\'[/dim]")',
    '            return',
    '        for skill_name, meta in matches:',
    '            try:',
    '                _install_one(skill_name, repo)',
    '            except Exception as e:',
    "                console.print(f'[red]{skill_name}: {e}[/red]')",
    "        console.print(f'[green]{len(matches)} skill(s) installed ({mode})[/green]')",
    '        return',
    '    if install_category:',
    '        matches = lib.find_skills_by_category(install_category, repo=repo)',
    '        if not matches:',
    '            console.print(f"[dim]No skills found in category \'{install_category}\'[/dim]")',
    '            return',
    '        for skill_name, meta in matches:',
    '            try:',
    '                _install_one(skill_name, repo)',
    '            except Exception as e:',
    "                console.print(f'[red]{skill_name}: {e}[/red]')",
    "        console.print(f'[green]{len(matches)} skill(s) installed ({mode})[/green]')",
    '        return',
    '    if not name:',
    '        from .metadata import scan_skill_dirs',
    '        target_repo = repo or lib.config.library.active_repo',
    '        backend = lib.repo_mgr.get_backend(target_repo)',
    '        all_skills = scan_skill_dirs(backend.skills_dir)',
    '        if not all_skills:',
    '            console.print(f"[dim]No skills found in repo \'{target_repo}\'[/dim]")',
    '            return',
    '        for skill_name, meta in all_skills:',
    '            try:',
    '                _install_one(skill_name, target_repo)',
    '            except Exception as e:',
    "                console.print(f'[red]{skill_name}: {e}[/red]')",
    '        console.print(f"[green]{len(all_skills)} skill(s) installed from \'{target_repo}\' ({mode})[/green]")',
    '        return',
    "    bare_name = name.split('/')[-1] if '/' in name else name.split(':')[-1] if ':' in name else name",
    '    _install_one(name, repo)',
    '    skill_dir = project.skills_dir / bare_name',
    '    if skill_dir.exists() or skill_dir.is_symlink():',
    '        target = skill_dir.resolve() if skill_dir.is_symlink() else skill_dir',
    '        if target.exists():',
    '            meta = extract_metadata(target)',
    '            report = check_requirements(bare_name, meta.requires)',
    '            if report.has_checks and (not report.all_ok):',
    "                console.print(f'[yellow]Warning: {report.failed} unmet requirement(s):[/yellow]')",
    '                for r in report.results:',
    '                    if not r.ok:',
    "                        console.print(f'  [red]✗[/red] {r.name} — {r.message}')",
    '',
    "@cli.command('uninstall')",
    "@click.argument('name', required=False, default=None)",
    "@click.option('-g', '--global', 'global_install', is_flag=True, help='Also uninstall from global agent config (~/.claude/skills/)')",
    '@_agent_option',
    '@_root_option',
    'def uninstall_cmd(name, global_install, agent, project_root):',
    '    """Uninstall skills from project, parent dirs, and optionally global.',
    '',
    '    \\x08',
    '    skillm uninstall deploy-k8s        Remove from project + parent dirs',
    '    skillm uninstall deploy-k8s -g     Also remove from ~/.claude/skills/',
    '    skillm uninstall                   Remove all from project + parent dirs',
    '    skillm uninstall -g                Remove all including global',
    '    """',
    '    from pathlib import Path',
    '    home = Path.home()',
    "    agent_dir_name = AGENT_DIRS.get(agent, f'.{agent}')",
    '    project_dir = Path(project_root).resolve() if project_root else Path.cwd().resolve()',
    '',
    '    def _uninstall_from_all(skill_name):',
    '        """Remove skill from project, parent dirs, and optionally home."""',
    '        removed = []',
    '        project = _get_project(agent=agent, project_root=project_root)',
    '        if project.drop(skill_name):',
    '            removed.append(str(project.skills_dir / skill_name))',
    '        current = project_dir.parent',
    '        while current != home.parent and current != current.parent:',
