    '            value = getattr(cls, name, _MISSING)',
    '            if isinstance(value, Field):',
    '                fields.append((name, value.default, value.default_factory))',
    '                if hasattr(cls, name):',
    '                    delattr(cls, name)',
    '            else:',
    '                fields.append((name, value, _MISSING))',
    '',
