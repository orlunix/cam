_SOURCES['tomllib'] = _join([
    '"""Small TOML reader for SkillM configuration files (Python 3.6 compatible)."""',
    'import ast',
    'import re',
    '',
    'class TOMLDecodeError(ValueError):',
    '    pass',
    '',
    'def _value(text):',
    '    text = text.strip()',
    "    if text in ('true', 'false'):",
    "        return text == 'true'",
    '    if text.startswith(\'"\') and text.endswith(\'"\'):',
    '        try:',
    '            return ast.literal_eval(text)',
    '        except (ValueError, SyntaxError):',
    "            raise TOMLDecodeError('invalid string')",
    "    if re.match('^[+-]?\\\\d+$', text):",
    '        return int(text)',
    "    if re.match('^[+-]?(?:\\\\d+\\\\.\\\\d*|\\\\d*\\\\.\\\\d+)$', text):",
    '        return float(text)',
    "    if text.startswith('[') and text.endswith(']'):",
    '        try:',
    "            return ast.literal_eval(text.replace('true', 'True').replace('false', 'False'))",
    '        except (ValueError, SyntaxError):',
    "            raise TOMLDecodeError('invalid array')",
    "    raise TOMLDecodeError('unsupported TOML value: {0}'.format(text))",
    '',
    'def loads(text):',
    '    result = {}',
    '    current = result',
    '    for number, raw in enumerate(text.splitlines(), 1):',
    "        line = raw.split('#', 1)[0].strip()",
    '        if not line:',
    '            continue',
    "        if line.startswith('[') and line.endswith(']'):",
    '            current = result',
    "            for part in line[1:-1].split('.'):",
    '                part = part.strip()',
    '                if not part:',
    "                    raise TOMLDecodeError('invalid table on line {0}'.format(number))",
    '                current = current.setdefault(part, {})',
    '            continue',
    "        if '=' not in line:",
    "            raise TOMLDecodeError('expected key/value on line {0}'.format(number))",
    "        key, value = line.split('=', 1)",
    '        key = key.strip()',
    '        if not key:',
    "            raise TOMLDecodeError('empty key on line {0}'.format(number))",
    '        current[key] = _value(value)',
    '    return result',
    '',
    'def load(source):',
    '    data = source.read()',
    '    if not isinstance(data, str):',
    "        data = data.decode('utf-8')",
    '    return loads(data)',
], True)
