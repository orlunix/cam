# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/*
!dist/camc
!dist/skillm
!dist/BUILD_LOG.md
build/
*.egg
# electron-builder's resource dir (icons for MSI/DMG) must be committed
!apps/cam-desktop/build/
!apps/cam-desktop/build/*

# Virtual environments
.venv/
venv/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Test/cache
.pytest_cache/
.mypy_cache/
htmlcov/
.coverage

# Extension vendor tooling (build-time only; the bundled artifact
# extensions/vendor/cam-assist/dist/cam-assist.js IS committed)
extensions/vendor/**/node_modules/

# OS
.DS_Store
Thumbs.db

# Temp files
*.tmp

# Local Git worktrees
.worktrees/

# Build artifacts
apps/cam-mobile/build/
apps/cam-mobile/cam-release.keystore
apps/cam-mobile/.upload-target

# Log files
scripts/*.log

# Benchmark generated workspaces (keep pinned summaries only)
benchmarks/**/runs/*
!benchmarks/**/runs/comparison-api-bench-final.json

# Images
.cam-images/

# Local toolchains (portable node for desktop builds)
.tools/

# Claude Code / sibling project workspaces (not part of cam)
.claude/
happy/
src/camc_ts/

# Demo runtime state
demos/*/.claude/scheduled_tasks.lock

# APK release artifacts
web/assets/*.apk
a.out
apps/cam-mobile/test/lockrepro/build/
